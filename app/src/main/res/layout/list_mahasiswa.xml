<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"

    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#223244"

    app:cardBackgroundColor="#151E2C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <!-- NO -->

        <TextView
            android:id="@+id/noTextView"
            android:layout_width="30dp"
            android:layout_height="30dp"

            android:gravity="center"

            android:text="1"
            android:textColor="#9CA3AF"
            android:textStyle="bold"
            android:textSize="13sp"/>


        <!-- FOTO -->

        <ImageView
            android:id="@+id/jkImageView"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:layout_marginStart="8dp"

            android:padding="8dp"

            android:background="@drawable/bg_avatar"

            android:src="@drawable/boy"/>


        <!-- DATA -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="12dp"

            android:orientation="vertical">

            <!-- NAMA -->

            <TextView
                android:id="@+id/namaTextView"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Juan Winardi"

                android:textColor="#FFFFFF"

                android:textSize="16sp"
                android:textStyle="bold"/>


            <!-- NIM -->

            <TextView
                android:id="@+id/nimTextView"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="231021111"

                android:textColor="#8D99AE"

                android:textSize="12sp"/>


            <!-- INFO -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:orientation="horizontal">

                <TextView
                    android:id="@+id/jkTextView"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="♂ Laki-Laki"

                    android:textColor="#4ADE80"

                    android:textSize="11sp"/>


                <TextView
                    android:id="@+id/jpTextView"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="12dp"

                    android:text="TI"

                    android:textColor="#60A5FA"

                    android:textStyle="bold"

                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- STATUS -->

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"

            android:background="@drawable/bg_status"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>